# MacroSnap 3.0 Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
# Get free MongoDB Atlas at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb://localhost:27017/macrosnap

# JWT Secret Key (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_this

# Server Port
PORT=5000

# USDA FoodData Central API Key
# Get your free API key at: https://fdc.nal.usda.gov/fdc-app.html#/api-key
USDA_API_KEY=your_usda_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
